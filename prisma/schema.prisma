generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum AccountType {
  BANK
  E_WALLET
  CASH
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  OPENING_BALANCE
  ADJUSTMENT
  REVERSAL
}

enum TransactionStatus {
  PENDING
  POSTED
  REVERSED
  VOIDED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum GoalType {
  EMERGENCY_FUND
  PERSONAL_SAVINGS
  PURCHASE
  TRAVEL
  OTHER
}

enum GoalMovementType {
  CONTRIBUTION
  WITHDRAWAL
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum OccurrenceStatus {
  SCHEDULED
  POSTED
  SKIPPED
  CANCELLED
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  SAVINGS_PROGRESS
  RECURRING_REMINDER
  SYSTEM
}

// ==========================================
// USERS & AUTHENTICATION
// ==========================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String    @map("full_name") @db.VarChar(120)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  accounts                Account[]
  categories              Category[]
  transactions            FinancialTransaction[]
  budgets                 Budget[]
  savingsGoals            SavingsGoal[]
  recurringRules          RecurringRule[]
  notifications           Notification[]
  attachments             Attachment[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// ==========================================
// ACCOUNTS
// ==========================================

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String      @db.VarChar(100)
  type           AccountType
  institution    String?     @db.VarChar(100)
  openingBalance BigInt      @default(0) @map("opening_balance")
  openingDate    DateTime    @map("opening_date") @db.Date
  color          String?     @db.VarChar(20)
  icon           String?     @db.VarChar(50)
  isArchived     Boolean     @default(false) @map("is_archived")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactionAccount   FinancialTransaction[] @relation("TransactionAccount")
  transferSources      FinancialTransaction[] @relation("TransferSource")
  transferDestinations FinancialTransaction[] @relation("TransferDestination")
  ledgerEntries        LedgerEntry[]
  recurringTemplates   RecurringRule[]        @relation("RecurringAccount")
  recurringSources     RecurringRule[]        @relation("RecurringSource")
  recurringDestinations RecurringRule[]       @relation("RecurringDestination")

  @@unique([id, userId])
  @@index([userId, isArchived])
  @@map("accounts")
}

// ==========================================
// CATEGORIES
// ==========================================

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  parentId   String?      @map("parent_id") @db.Uuid
  name       String       @db.VarChar(80)
  type       CategoryType
  icon       String?      @db.VarChar(50)
  color      String?      @db.VarChar(20)
  isDefault  Boolean      @default(false) @map("is_default")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]             @relation("CategoryHierarchy")
  transactions FinancialTransaction[]
  budgetLimits BudgetCategoryLimit[]
  recurringRules RecurringRule[]     @relation("RecurringCategory")

  @@unique([id, userId])
  @@index([userId, type, isArchived])
  @@index([parentId])
  @@map("categories")
}

// ==========================================
// FINANCIAL TRANSACTIONS
// ==========================================

model FinancialTransaction {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @map("user_id") @db.Uuid
  categoryId           String? @map("category_id") @db.Uuid
  accountId            String? @map("account_id") @db.Uuid
  sourceAccountId      String? @map("source_account_id") @db.Uuid
  destinationAccountId String? @map("destination_account_id") @db.Uuid

  type            TransactionType
  status          TransactionStatus @default(POSTED)
  amount          BigInt
  transactionDate DateTime          @map("transaction_date") @db.Date
  description     String?           @db.VarChar(255)
  notes           String?           @db.Text
  idempotencyKey  String?           @map("idempotency_key") @db.VarChar(100)

  originalTransactionId String?               @unique @map("original_transaction_id") @db.Uuid
  originalTransaction   FinancialTransaction? @relation("TransactionReversal", fields: [originalTransactionId], references: [id], onDelete: Restrict)
  reversal              FinancialTransaction? @relation("TransactionReversal")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedAt  DateTime? @map("posted_at") @db.Timestamptz(3)
  voidedAt  DateTime? @map("voided_at") @db.Timestamptz(3)

  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account            Account?  @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  sourceAccount      Account?  @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account?  @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)

  ledgerEntries        LedgerEntry[]
  goalMovements        GoalMovement[]
  attachments          Attachment[]
  recurringOccurrences RecurringOccurrence[]

  @@unique([userId, idempotencyKey])
  @@index([userId, transactionDate])
  @@index([userId, type, status, transactionDate])
  @@index([accountId, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([sourceAccountId, transactionDate])
  @@index([destinationAccountId, transactionDate])
  @@map("financial_transactions")
}

// ==========================================
// ACCOUNT LEDGER
// ==========================================

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  direction     LedgerDirection
  amount        BigInt
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

// ==========================================
// BUDGET
// ==========================================

model Budget {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  year      Int
  month     Int
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  categoryLimits BudgetCategoryLimit[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("budgets")
}

model BudgetCategoryLimit {
  id          String   @id @default(uuid()) @db.Uuid
  budgetId    String   @map("budget_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  limitAmount BigInt   @map("limit_amount")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
  @@index([categoryId])
  @@map("budget_category_limits")
}

// ==========================================
// SAVINGS GOALS
// ==========================================

model SavingsGoal {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(100)
  type         GoalType  @default(OTHER)
  targetAmount BigInt    @map("target_amount")
  targetDate   DateTime? @map("target_date") @db.Date
  description  String?   @db.Text
  color        String?   @db.VarChar(20)
  isCompleted  Boolean   @default(false) @map("is_completed")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements GoalMovement[]

  @@index([userId, isCompleted])
  @@map("savings_goals")
}

model GoalMovement {
  id            String           @id @default(uuid()) @db.Uuid
  goalId        String           @map("goal_id") @db.Uuid
  transactionId String?          @map("transaction_id") @db.Uuid
  type          GoalMovementType
  amount        BigInt
  movementDate  DateTime         @map("movement_date") @db.Date
  notes         String?          @db.VarChar(255)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  goal        SavingsGoal           @relation(fields: [goalId], references: [id], onDelete: Restrict)
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([goalId, movementDate])
  @@index([transactionId])
  @@map("goal_movements")
}

// ==========================================
// RECURRING TRANSACTIONS
// ==========================================

model RecurringRule {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  name       String              @db.VarChar(100)
  type       TransactionType
  amount     BigInt
  frequency  RecurrenceFrequency
  interval   Int                 @default(1)
  dayOfMonth Int?                @map("day_of_month")
  dayOfWeek  Int?                @map("day_of_week")
  accountId            String?   @map("account_id") @db.Uuid
  categoryId           String?   @map("category_id") @db.Uuid
  sourceAccountId      String?   @map("source_account_id") @db.Uuid
  destinationAccountId String?   @map("destination_account_id") @db.Uuid
  startDate  DateTime            @map("start_date") @db.Date
  endDate    DateTime?           @map("end_date") @db.Date
  nextRunAt  DateTime?           @map("next_run_at") @db.Date
  isActive   Boolean             @default(true) @map("is_active")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  account            Account?  @relation("RecurringAccount", fields: [accountId], references: [id], onDelete: Restrict)
  category           Category? @relation("RecurringCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  sourceAccount      Account?  @relation("RecurringSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account?  @relation("RecurringDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  occurrences RecurringOccurrence[]

  @@index([userId, isActive, nextRunAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("recurring_rules")
}

model RecurringOccurrence {
  id              String           @id @default(uuid()) @db.Uuid
  recurringRuleId String           @map("recurring_rule_id") @db.Uuid
  transactionId   String?          @unique @map("transaction_id") @db.Uuid
  scheduledDate   DateTime         @map("scheduled_date") @db.Date
  status          OccurrenceStatus @default(SCHEDULED)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recurringRule RecurringRule         @relation(fields: [recurringRuleId], references: [id], onDelete: Restrict)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([recurringRuleId, scheduledDate])
  @@index([status, scheduledDate])
  @@map("recurring_occurrences")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(150)
  message   String           @db.Text
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ==========================================
// ATTACHMENTS
// ==========================================

model Attachment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  fileName      String   @map("file_name") @db.VarChar(255)
  storageKey    String   @unique @map("storage_key") @db.VarChar(500)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  fileSize      BigInt   @map("file_size")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, transactionId])
  @@map("attachments")
}

// ==========================================
// AUDIT LOGS
// ==========================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(100)
  action     String   @db.VarChar(50)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
