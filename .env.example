# Database
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DB_HOST:5432/postgres"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NODE_ENV dikelola otomatis oleh Next.js/Vercel; jangan set manual di production.

# Authentication
# SESSION_SECRET belum dipakai oleh implementasi session saat ini.
SESSION_SECRET="replace-with-a-long-random-secret"

# Production Supabase: tambahkan connection_limit=1&sslmode=require pada DATABASE_URL.

# Seed - development only
SEED_USER_NAME="Development User"
SEED_USER_EMAIL="dev@example.com"
SEED_USER_PASSWORD="replace-with-a-strong-password"
